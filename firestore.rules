rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'sunnyjiansari456@gmail.com') ||
        (request.auth.token.email == 'gulamaftab74@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isVerified() && isValidId(userId) && (
        (request.auth.uid == userId && incoming().uid == existing().uid && (incoming().role == existing().role || isAdmin()))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(postId)
        && incoming().authorId == request.auth.uid
        && incoming().content is string && incoming().content.size() <= 3000;
      allow update: if isVerified() && isValidId(postId) && (
        // Author updating content
        (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        // Other authenticated users updating likes/comments counts or interaction arrays
        (incoming().authorId == existing().authorId && incoming().content == existing().content) ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Short Videos
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(videoId)
        && incoming().creatorId == request.auth.uid
        && incoming().videoUrl is string && incoming().videoUrl.size() <= 2048;
      allow update: if isVerified() && isValidId(videoId) && (
        (existing().creatorId == request.auth.uid && incoming().creatorId == existing().creatorId) ||
        // Increment views or likes
        (incoming().creatorId == existing().creatorId && incoming().videoUrl == existing().videoUrl) ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(videoId) && (existing().creatorId == request.auth.uid || isAdmin());
    }

    // Stories (24h temporary stories)
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(storyId)
        && incoming().authorId == request.auth.uid
        && incoming().mediaUrl is string && incoming().mediaUrl.size() <= 2048;
      allow update: if isVerified() && isValidId(storyId) && (
        (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(storyId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Groups & Communities
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(groupId) && incoming().creatorId == request.auth.uid;
      allow update: if isVerified() && isValidId(groupId) && (
        existing().creatorId == request.auth.uid ||
        incoming().creatorId == existing().creatorId ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(groupId) && (existing().creatorId == request.auth.uid || isAdmin());
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(messageId)
        && incoming().senderId == request.auth.uid
        && incoming().content is string && incoming().content.size() <= 3000;
      allow update: if isVerified() && isValidId(messageId) && (
        (existing().senderId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
    }

    // Calls (Audio / Video call signaling)
    match /calls/{callId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(callId) && incoming().callerId == request.auth.uid;
      allow update: if isVerified() && isValidId(callId) && (
        existing().callerId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isVerified() && isValidId(callId) && (
        existing().callerId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(notificationId) && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && (existing().recipientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().recipientId == request.auth.uid || isAdmin());
    }

    // Reports (Content moderation)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isVerified() && isValidId(reportId) && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
